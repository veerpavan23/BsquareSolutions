datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LOCKED
  INACTIVE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
}

enum BatchStatus {
  PLANNED
  REGISTRATIONS_OPEN
  ALMOST_FULL
  FULL
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
  ARCHIVED
}

enum BatchSessionType {
  FREE_DEMO
  WEEKDAY_BATCH
  WEEKEND_BATCH
  CORPORATE_BATCH
}

enum LeadType {
  CONTACT
  COURSE_ENQUIRY
  DEMO_BOOKING
  CALLBACK
  INTERNSHIP_ENQUIRY
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  CONVERTED
  LOST
  DUPLICATE
}

enum LeadSource {
  WEBSITE
  COURSE_PAGE
  DEMO_PAGE
  CONTACT_PAGE
  WHATSAPP
  REFERRAL
  OTHER
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TrainingMode {
  ONLINE
  CLASSROOM
  HYBRID
  CORPORATE
  SELF_PACED
}

enum TrainerAssignmentRole {
  PRIMARY
  BACKUP
  GUEST
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  CREATE_RECORD
  UPDATE_RECORD
  DELETE_RECORD
  PUBLISH_COURSE
  UNPUBLISH_COURSE
  RESCHEDULE_BATCH
  PERMISSION_UPDATE
  CREATE_STUDENT
  UPDATE_STUDENT
  SUSPEND_STUDENT
  ASSIGN_STUDENT_COURSE
  ENABLE_LMS_ACCESS
  DISABLE_LMS_ACCESS
  RESET_STUDENT_PASSWORD
  CREATE_INTERNSHIP
  UPDATE_INTERNSHIP
  PUBLISH_INTERNSHIP
}

enum BranchType {
  HEAD_OFFICE
  TRAINING_CENTER
  CORPORATE_OFFICE
  ONLINE
  PARTNER_CENTER
}

enum ExternalSystem {
  SALESFORCE
  LMS
  RAZORPAY
  WHATSAPP
  GOOGLE_CALENDAR
  GOOGLE_MEET
  ZOOM
  ACCOUNTING_SYSTEM
  MARKETING_PLATFORM
  OTHER
}

enum SyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
  CONFLICT
  DISABLED
}

enum ActivityVisibility {
  INTERNAL
  ADMIN_ONLY
  TRAINER_VISIBLE
  STUDENT_VISIBLE
  PUBLIC
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
  WEBHOOK
}

enum NotificationStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  PARTIALLY_SENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  JSON
  URL
  EMAIL
  SECRET
  SELECT
  MULTI_SELECT
}

enum SettingCategory {
  GENERAL
  BRANDING
  CONTACT
  SEO
  TRAINING
  BATCH
  AUTHENTICATION
  SECURITY
  EMAIL
  NOTIFICATIONS
  STORAGE
  INTEGRATIONS
  ANALYTICS
  HOMEPAGE
  CORPORATE
  AI
  LMS
  FEATURE_FLAGS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BatchChangeType {
  TIMINGS
  RESCHEDULE
  TRAINER_CHANGE
  CAPACITY_CHANGE
  STATUS_CHANGE
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BatchWaitlistStatus {
  WAITING
  INVITED
  CONVERTED
  DECLINED
  EXPIRED
  REMOVED
}

enum HomepageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomepageSectionType {
  ANNOUNCEMENT_BAR
  HERO
  STATISTICS
  ACADEMY_GRID
  FEATURED_COURSES
  UPCOMING_BATCHES
  LEARNING_PATHS
  WHY_BSQUARE
  TRAINER_HIGHLIGHTS
  TESTIMONIALS
  CORPORATE_TRAINING_CTA
  FREE_RESOURCES
  FAQ
  CONTACT_CTA
  PARTNER_LOGOS
  CUSTOM_CONTENT
}

enum ContentBlockType {
  RICH_TEXT
  IMAGE_TEXT
  STATISTICS
  CARD_GRID
  COURSE_GRID
  TRAINER_GRID
  FAQ
  CTA
  VIDEO
  TIMELINE
  CONTACT_DETAILS
}

model AdminUser {
  id               String          @id @default(cuid())
  fullName         String
  email            String          @unique
  phone            String?
  passwordHash     String
  status           AdminUserStatus @default(ACTIVE)
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  sessionVersion   Int             @default(1)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sessions              AdminSession[]
  auditLogs             AuditLog[]
  preferences           AdminPreference[]
  savedViews            SavedView[]
  createdCourses        Course[]                @relation("CourseCreatedBy")
  updatedCourses        Course[]                @relation("CourseUpdatedBy")
  submittedCourses      Course[]                @relation("CourseSubmittedBy")
  reviewedCourses       Course[]                @relation("CourseReviewedBy")
  approvedCourses       Course[]                @relation("CourseApprovedBy")
  createdBatches        Batch[]                 @relation("BatchCreatedBy")
  updatedBatches        Batch[]                 @relation("BatchUpdatedBy")
  mediaAssets           MediaAsset[]            @relation("MediaUploadedBy")
  changeLogs            BatchChangeLog[]        @relation("BatchLogChangedBy")
  courseVersions        CourseVersion[]         @relation("VersionChangedBy")
  approvedTimeOffs      TrainerTimeOff[]        @relation("TimeOffApprovedBy")
  receivedNotifications NotificationRecipient[] @relation("NotificationRecipientAdmin")
  assignedLeads         Lead[]                  @relation("LeadAssignedTo")
}

model AdminSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  lastSeenAt       DateTime?
  ipAddress        String?
  userAgent        String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String?
  isSystemRole Boolean          @default(false)
  isProtected  Boolean          @default(false)
  isActive     Boolean          @default(true)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  users        AdminUser[]
  permissions  RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id             String     @id @default(cuid())
  branchCode     String     @unique
  branchName     String
  slug           String     @unique
  branchType     BranchType
  addressLine1   String
  addressLine2   String?
  city           String
  district       String?
  state          String
  postalCode     String
  country        String     @default("India")
  phone          String
  alternatePhone String?
  email          String
  timezone       String     @default("Asia/Kolkata")
  latitude       Float?
  longitude      Float?
  googleMapsUrl  String?
  isHeadOffice   Boolean    @default(false)
  isActive       Boolean    @default(true)
  displayOrder   Int        @default(0)
  recordVersion  Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  users      AdminUser[]
  classrooms Classroom[]
  batches    Batch[]
  trainers   TrainerAvailability[]
}

model Classroom {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classroomCode String
  classroomName String
  capacity      Int
  floor         Int?
  facilities    String? // comma-separated values
  isActive      Boolean   @default(true)
  recordVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  batches Batch[]

  @@unique([branchId, classroomCode])
}

model Academy {
  id               String           @id @default(cuid())
  name             String           @unique
  slug             String           @unique
  shortDescription String?
  fullDescription  String?
  icon             String?
  thumbnail        String?
  banner           String?
  displayOrder     Int              @default(0)
  isFeatured       Boolean          @default(false)
  isActive         Boolean          @default(true)
  publishStatus    PublishStatus    @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  openGraphImage   String?
  recordVersion    Int              @default(1)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  courses            Course[]
  categories         CourseCategory[]
  leads              Lead[]
  internshipPrograms InternshipProgram[]
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id])
  courses   Course[]

  @@unique([academyId, slug])
}

model Course {
  id                    String         @id @default(cuid())
  code                  String         @unique
  title                 String
  shortTitle            String?
  slug                  String         @unique
  academyId             String
  academy               Academy        @relation(fields: [academyId], references: [id])
  categoryId            String
  category              CourseCategory @relation(fields: [categoryId], references: [id])
  level                 CourseLevel
  status                CourseStatus   @default(DRAFT)
  shortDescription      String?
  description           String
  durationValue         Int?
  durationUnit          DurationUnit?
  learningHours         Int?
  numberOfSessions      Int?
  standardPrice         Decimal?
  discountedPrice       Decimal?
  currency              String         @default("INR")
  showPricePublicly     Boolean        @default(true)
  isFeatured            Boolean        @default(false)
  isTrending            Boolean        @default(false)
  isCertificationCourse Boolean        @default(false)
  thumbnailUrl          String?
  brochureUrl           String?
  metaTitle             String?
  metaDescription       String?
  publishedAt           DateTime?
  scheduledPublishAt    DateTime?
  scheduledUnpublishAt  DateTime?
  reviewComments        String?
  recordVersion         Int            @default(1)

  createdById   String?
  createdBy     AdminUser? @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     AdminUser? @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedById String?
  submittedBy   AdminUser? @relation("CourseSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    AdminUser? @relation("CourseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    AdminUser? @relation("CourseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  approvedAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  modules            CourseModule[]
  prerequisites      CoursePrerequisite[]
  highlights         CourseHighlight[]
  projects           CourseProject[]
  batches            Batch[]
  trainerAssignments CourseTrainer[]
  versions           CourseVersion[]
  leads              Lead[]
  studentAssignments StudentCourseAssignment[]

  @@index([academyId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([publishedAt])
}

model CourseModule {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  topics      CourseTopic[]

  @@unique([courseId, position])
  @@index([courseId])
}

model CourseTopic {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int

  @@unique([moduleId, position])
}

model CoursePrerequisite {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
}

model CourseHighlight {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
}

model CourseProject {
  id          String            @id @default(cuid())
  courseId    String
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  difficulty  ProjectDifficulty
  isCapstone  Boolean           @default(false)
  skills      ProjectSkill[]
}

model ProjectSkill {
  id        String        @id @default(cuid())
  projectId String
  project   CourseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillName String
}

model Trainer {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  email           String    @unique
  phone           String?
  designation     String
  bio             String
  linkedinUrl     String?
  experienceYears Int       @default(0)
  certifications  String? // SQLite treats it as TEXT (mapped from String)
  specializations String? // SQLite treats it as TEXT (mapped from String)
  rating          Decimal   @default(5.0)
  avatarUrl       String?
  isActive        Boolean   @default(true)
  publicEmail     Boolean   @default(false)
  publicPhone     Boolean   @default(false)
  publicProfile   Boolean   @default(true)
  timezone        String    @default("Asia/Kolkata")
  recordVersion   Int       @default(1)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  courses           CourseTrainer[]
  batches           BatchTrainer[]
  availabilityRules TrainerAvailability[]
  timeOffs          TrainerTimeOff[]
}

model CourseTrainer {
  courseId  String
  trainerId String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([courseId, trainerId])
}

model TrainerAvailability {
  id            String       @id @default(cuid())
  trainerId     String
  trainer       Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dayOfWeek     DayOfWeek
  startTime     String // "HH:mm" format
  endTime       String // "HH:mm" format
  timezone      String       @default("Asia/Kolkata")
  mode          TrainingMode
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isAvailable   Boolean      @default(true)
}

model TrainerTimeOff {
  id            String        @id @default(cuid())
  trainerId     String
  trainer       Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startDateTime DateTime
  endDateTime   DateTime
  reason        String
  status        TimeOffStatus @default(APPROVED)
  approvedById  String?
  approvedBy    AdminUser?    @relation("TimeOffApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}

model Batch {
  id                  String       @id @default(cuid())
  code                String       @unique
  courseId            String
  course              Course       @relation(fields: [courseId], references: [id])
  branchId            String?
  branch              Branch?      @relation(fields: [branchId], references: [id])
  classroomId         String?
  classroom           Classroom?   @relation(fields: [classroomId], references: [id])
  startDate           DateTime
  endDate             DateTime?
  registrationCloseAt DateTime?
  timezone            String       @default("Asia/Kolkata")
  mode                TrainingMode
  capacity            Int              @default(30)
  seatsFilled         Int              @default(0)
  status              BatchStatus      @default(PLANNED)
  sessionType         BatchSessionType @default(WEEKDAY_BATCH)
  publicVisibility    Boolean          @default(true)
  description         String?
  recordVersion       Int              @default(1)

  createdById String?
  createdBy   AdminUser? @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser? @relation("BatchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schedules  BatchSchedule[]
  trainers   BatchTrainer[]
  changeLogs BatchChangeLog[]
  waitlist           BatchWaitlistEntry[]
  leads              Lead[]
  studentAssignments StudentCourseAssignment[]

  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

model BatchSchedule {
  id            String    @id @default(cuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek     DayOfWeek
  startTime     String // "HH:mm" format
  endTime       String // "HH:mm" format
  position      Int       @default(0)
  timezone      String    @default("Asia/Kolkata")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
}

model BatchTrainer {
  batchId   String
  trainerId String
  role      TrainerAssignmentRole
  batch     Batch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer   Trainer               @relation(fields: [trainerId], references: [id])

  @@id([batchId, trainerId, role])
}

model BatchWaitlistEntry {
  id          String              @id @default(cuid())
  batchId     String
  batch       Batch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  position    Int
  status      BatchWaitlistStatus @default(WAITING)
  joinedAt    DateTime            @default(now())
  convertedAt DateTime?
  notes       String?
}

model BatchChangeLog {
  id                 String          @id @default(cuid())
  batchId            String
  batch              Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  changedById        String
  changedBy          AdminUser       @relation("BatchLogChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  previousVal        String // SQLite stores JSON as string
  newVal             String // SQLite stores JSON as string
  reason             String
  changeType         BatchChangeType @default(TIMINGS)
  notificationStatus String          @default("PENDING")
  createdAt          DateTime        @default(now())
}

model CourseVersion {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version     Int
  changedById String
  changedBy   AdminUser @relation("VersionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  diff        String // SQLite stores JSON as string
  createdAt   DateTime  @default(now())

  @@unique([courseId, version])
}

model AuditLog {
  id            String      @id @default(cuid())
  actorUserId   String?
  actorEmail    String?
  actorRole     String?
  action        AuditAction
  module        String
  entityType    String?
  entityId      String?
  entityLabel   String?
  previousValue String? // SQLite stores JSON as string
  newValue      String? // SQLite stores JSON as string
  metadata      String? // SQLite stores JSON as string
  reason        String?
  ipAddress     String?
  userAgent     String?
  success       Boolean     @default(true)
  createdAt     DateTime    @default(now())

  actor AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([module])
  @@index([createdAt])
}

model PasswordResetToken {
  id                 String    @id @default(cuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  requestedIp        String?
  requestedUserAgent String?
  usedByIp           String?
  createdAt          DateTime  @default(now())
}

model MediaFolder {
  id        String       @id @default(cuid())
  name      String       @unique
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
}

model MediaTag {
  id     String          @id @default(cuid())
  name   String          @unique
  assets MediaAssetTag[]
}

model MediaAsset {
  id               String          @id @default(cuid())
  folderId         String?
  folder           MediaFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileName         String
  originalFileName String
  storageKey       String          @unique
  storageProvider  String          @default("supabase")
  url              String
  desktopUrl       String?
  tabletUrl        String?
  mobileUrl        String?
  mimeType         String
  fileExtension    String
  fileSize         Int
  width            Int?
  height           Int?
  uploadedById     String
  uploadedBy       AdminUser       @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  status           String          @default("ACTIVE") // ACTIVE, ARCHIVED, FAILED
  altText          String?
  caption          String?
  checksum         String?
  usageCount       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  tags             MediaAssetTag[]
}

model MediaAssetTag {
  assetId String
  tagId   String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     MediaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
}

model SettingDefinition {
  key              String           @id
  category         SettingCategory
  label            String
  description      String?
  valueType        SettingValueType
  defaultValue     String?
  validationSchema String?
  isSecret         Boolean          @default(false)
  isRequired       Boolean          @default(false)
  isPublic         Boolean          @default(true)
  displayOrder     Int              @default(0)
  values           SettingValue[]
}

model SettingValue {
  id         String            @id @default(cuid())
  settingKey String
  definition SettingDefinition @relation(fields: [settingKey], references: [key], onDelete: Cascade)
  value      String
  updatedAt  DateTime          @updatedAt

  @@unique([settingKey])
}

model ExternalReference {
  id                String         @id @default(cuid())
  entityType        String
  entityId          String
  externalSystem    ExternalSystem
  externalId        String
  syncStatus        SyncStatus     @default(NOT_SYNCED)
  lastSyncedAt      DateTime?
  lastSyncAttemptAt DateTime?
  syncError         String?
  metadata          String? // SQLite stores JSON as string
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([externalSystem, externalId])
  @@unique([entityType, entityId, externalSystem])
}

model ActivityEvent {
  id               String             @id @default(cuid())
  entityType       String
  entityId         String
  eventType        String
  title            String
  description      String
  actorUserId      String?
  actorDisplayName String?
  metadata         String? // SQLite stores JSON as string
  visibility       ActivityVisibility @default(INTERNAL)
  createdAt        DateTime           @default(now())
}

model Notification {
  id                  String                  @id @default(cuid())
  notificationType    String
  channel             NotificationChannel
  templateId          String?
  subject             String?
  payload             String // SQLite stores JSON as string
  priority            NotificationPriority    @default(NORMAL)
  status              NotificationStatus      @default(DRAFT)
  scheduledAt         DateTime?
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  retryCount          Int                     @default(0)
  maximumRetries      Int                     @default(3)
  failureReason       String?
  relatedEntityType   String?
  relatedEntityId     String?
  createdById         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  recipients          NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  adminUserId    String?
  adminUser      AdminUser?   @relation("NotificationRecipientAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  email          String?
  phone          String?
  readAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
}

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  description       String?
  isEnabled         Boolean   @default(false)
  environment       String    @default("PRODUCTION") // DEVELOPMENT, TEST, STAGING, PRODUCTION
  rolloutPercentage Int       @default(100)
  allowedRoles      String? // Comma-separated roles
  configuration     String? // SQLite stores JSON as string
  enabledFrom       DateTime?
  enabledUntil      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AdminPreference {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
}

model SavedView {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  name      String
  filters   String // SQLite stores JSON as string
  sorting   String? // SQLite stores JSON as string
  columns   String? // Comma-separated columns
  pageSize  Int       @default(10)
  isDefault Boolean   @default(false)
  isShared  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model HomepageVersion {
  id                 String            @id @default(cuid())
  name               String
  status             HomepageStatus    @default(DRAFT)
  recordVersion      Int               @default(1)
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  createdById        String?
  approvedById       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sections           HomepageSection[]
}

model HomepageSection {
  id                String              @id @default(cuid())
  homepageVersionId String
  homepageVersion   HomepageVersion     @relation(fields: [homepageVersionId], references: [id], onDelete: Cascade)
  sectionType       HomepageSectionType
  title             String?
  subtitle          String?
  internalName      String
  configuration     String // SQLite stores JSON as string
  displayOrder      Int                 @default(0)
  isEnabled         Boolean             @default(true)
  desktopEnabled    Boolean             @default(true)
  tabletEnabled     Boolean             @default(true)
  mobileEnabled     Boolean             @default(true)
  backgroundStyle   String              @default("DEFAULT")
  themeVariant      String              @default("LIGHT")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ContentPage {
  id              String               @id @default(cuid())
  title           String
  slug            String               @unique
  pageType        String // ABOUT, CONTACT, CORPORATE, PRIVACY, TERMS
  status          ContentPageStatus    @default(DRAFT)
  recordVersion   Int                  @default(1)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  noIndex         Boolean              @default(false)
  publishedAt     DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  sections        ContentPageSection[]
}

model ContentPageSection {
  id           String           @id @default(cuid())
  pageId       String
  page         ContentPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockType    ContentBlockType
  title        String?
  content      String? // rich text content
  payload      String? // SQLite stores JSON as string
  displayOrder Int              @default(0)
}

model Lead {
  id                  String       @id @default(cuid())
  name                String
  email               String?
  phone               String?
  city                String?
  company             String?
  currentRole         String?
  interestedVertical  String?
  interestedCourse    String?
  demoSession         String?
  preferredMode       String?
  message             String?
  
  leadType            LeadType     @default(CONTACT)
  source              LeadSource   @default(WEBSITE)
  status              LeadStatus   @default(NEW)
  priority            LeadPriority @default(NORMAL)
  
  academyId           String?
  academy             Academy?     @relation(fields: [academyId], references: [id], onDelete: SetNull)
  courseId            String?
  course              Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId             String?
  batch               Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  internshipId        String?
  internship          InternshipProgram? @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  
  assignedToId        String?
  assignedTo          AdminUser?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  nextFollowUpDate    DateTime?
  internalNotes       String?
  consent             Boolean      @default(false)
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
}

model NavigationMenu {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  items       NavigationItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model NavigationItem {
  id           String          @id @default(cuid())
  menuId       String
  menu         NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavigationItem? @relation("NavigationChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     NavigationItem[] @relation("NavigationChildren")
  
  label        String
  url          String
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  openInNewTab Boolean         @default(false)
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([menuId])
  @@index([parentId])
}

// ==========================================
// STUDENT & LMS MANAGEMENT
// ==========================================

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
  REFUNDED
}

model Student {
  id               String          @id @default(cuid())
  studentId        String          @unique
  fullName         String
  email            String          @unique
  phone            String
  loginEmail       String          @unique
  passwordHash     String
  status           StudentStatus   @default(ACTIVE)
  lmsAccessEnabled Boolean         @default(false)
  lmsAccessStart   DateTime?
  lmsAccessEnd     DateTime?
  paymentStatus    PaymentStatus   @default(PENDING)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  courseAssignments StudentCourseAssignment[]
}

model StudentCourseAssignment {
  studentId  String
  courseId   String
  batchId    String?
  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch      Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  assignedAt DateTime @default(now())

  @@id([studentId, courseId])
}

// ==========================================
// INTERNSHIP PROGRAMS
// ==========================================

model InternshipProgram {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  shortDescription   String?
  description        String
  academyId          String?
  academy            Academy?        @relation(fields: [academyId], references: [id], onDelete: SetNull)
  durationValue      Int?
  durationUnit       DurationUnit?
  trainingModes      String?         // comma-separated TrainingMode values
  standardFee        Decimal?
  currency           String          @default("INR")
  showFeePublicly    Boolean         @default(true)
  startDate          DateTime?
  applicationOpenAt  DateTime?
  applicationCloseAt DateTime?
  capacity           Int?
  status             PublishStatus   @default(DRAFT)
  isFeatured         Boolean         @default(false)
  thumbnailUrl       String?
  metaTitle          String?
  metaDescription    String?
  recordVersion      Int             @default(1)
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  
  leads              Lead[]
}
